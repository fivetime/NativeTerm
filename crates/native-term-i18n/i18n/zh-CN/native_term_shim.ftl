reopening = [NativeTerm] 正在新标签中重新打开这个恢复的会话…
restored = [NativeTerm] { $alias }：已恢复，尚未连接。
ssh-not-started = [NativeTerm] 无法启动 ssh（{ $path }）：{ $error }
login-failed = [NativeTerm] 登录失败或已取消（退出码 { $code }）。
disconnected = [NativeTerm] 连接已断开（退出码 { $code }）。
ended = [NativeTerm] 会话已结束（退出码 { $code }）。
reconnect-or-close = [NativeTerm] 按 R 重新连接，按 C 关闭此标签。
any-key = [NativeTerm] 按任意键关闭。
