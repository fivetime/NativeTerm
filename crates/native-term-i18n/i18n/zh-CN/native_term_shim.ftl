reopening = [NativeTerm] 正在新标签中重新打开这个恢复的会话…
restored = [NativeTerm] { $alias }：已恢复，尚未连接。
ssh-not-started = [NativeTerm] 无法启动 ssh（{ $path }）：{ $error }
login-failed = [NativeTerm] 登录失败或已取消（退出码 { $code }）。
persistent-session = [NativeTerm] 会话保持在服务器的 { $program } 中（会话 { $name }）。
persistent-missing = [NativeTerm] 此主机没有安装 { $program }：已改用普通 shell，断线后不会保留。
persistent-own-command = [NativeTerm] { $alias } 已有自己的 RemoteCommand：会话不会保持在服务器上。
unreachable = [NativeTerm] 无法连接到服务器（退出码 { $code }）。
disconnected = [NativeTerm] 连接已断开（退出码 { $code }）。
ended = [NativeTerm] 会话已结束（退出码 { $code }）。
reconnect-or-close = [NativeTerm] 按 R 重新连接，按 C 关闭此标签。
any-key = [NativeTerm] 按任意键关闭。
key-installing = [NativeTerm] 正在把 { $path } 添加到 { $alias }，ssh 可能会要求输入密码。
key-windows-host = { $alias } 是 Windows 主机：改用 PowerShell 方式添加公钥（ssh 可能会再问一次密码）。
key-installed = [NativeTerm] 完成：{ $alias } 已接受这把公钥。
key-batch-intro = [NativeTerm] 依次把 { $path } 添加到 { $count } 台主机。
key-batch-password = [NativeTerm] 这些主机的密码，每台都用它，只保存在内存里（直接回车：每台单独询问）：
key-batch-each = [NativeTerm] 每台主机单独询问密码。
key-batch-no-helper = [NativeTerm] 无法共用密码（{ $error }），每台主机单独询问。
key-batch-summary = [NativeTerm] 完成：{ $installed } 台已添加，{ $present } 台原本就有，{ $failed } 台失败。
key-batch-failed-hosts = [NativeTerm] 失败：{ $hosts }（密码不同？请逐台安装）。
key-present = [NativeTerm] { $alias } 已经有这把公钥。
key-failed = [NativeTerm] 公钥没有添加到 { $alias }（退出码 { $code }）。没有 POSIX shell 的网络设备不能用这种方式添加。
key-login-refused = [NativeTerm] { $alias } 拒绝了登录（密码不对？），公钥没有添加。
key-unreadable = [NativeTerm] 无法使用 { $path }：{ $error }
key-creating = [NativeTerm] 正在 { $path } 生成密钥对。可以设置私钥密码保护它（ssh-agent 可以记住密码）。
key-created = [NativeTerm] 已生成，公钥是 { $path }。
key-exists = [NativeTerm] { $path } 已经存在，没有做任何修改。
key-create-failed = [NativeTerm] 没有生成密钥：{ $error }
agent-adding = [NativeTerm] 正在把你的密钥添加到 ssh-agent，每把密钥输入一次私钥密码。
agent-added = [NativeTerm] 完成：在注销之前，ssh 不会再询问这些私钥密码。
agent-add-failed = [NativeTerm] ssh-add 失败：{ $error }。ssh-agent 服务在运行吗？
plink-connecting = [NativeTerm] 正在用 { $client } 连接 { $target }（{ $protocol }）…
plink-disconnected = [NativeTerm] 连接已断开。
plink-failed = [NativeTerm] 无法连接（退出码 { $code }）。
plink-gone = [NativeTerm] { $alias } 已不再是保存的会话。
plink-missing = [NativeTerm] 找不到 ntplink.exe 或 plink.exe：请把 ntplink.exe 放在 NativeTerm 旁边，或安装 PuTTY。
plink-not-started = [NativeTerm] 无法启动 { $client }（{ $path }）：{ $error }
plink-bad-session = [NativeTerm] { $alias } 无法使用：{ $error }
plink-no-control = [NativeTerm] 本次连接无法发送 Break 和 Telnet 命令：{ $error }
plink-load-failed = [NativeTerm] 无法传递该会话的 PuTTY 选项：{ $error }
port-busy = [NativeTerm] { $line } 正被其他程序或会话占用。
port-unavailable = [NativeTerm] 无法打开 { $line }：{ $error }
